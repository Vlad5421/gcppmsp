{% extends 'admin/admin_index.html.twig' %}

{% block title %}Создание услуг{% endblock %}

{% block body %}
<div>
    <span>Точно удалить пользователя: {{ user.FIO }}
</div>

<form>
    <div class="input-group mb-3">

        <div class="form-check" style="margin-right: 10px;">
            <input type="checkbox"
                    name="confirmDeleting"
                    class="form-check-input"
            >
            <label class="form-check-label" value="true">Подтвердить удаление</label>
        </div>
        

    </div>
    <div>
        <button type="submit" class="btn btn-outline-secondary">Удалить</button>
    </div>
</form>

<hr style="background: white;">
    

{% endblock %}
