{% extends 'admin/admin_index_cards.html.twig' %}

{% block title %}Детали записи #{{ submission.id }}{% endblock %}

{% block content %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <h1>Детали записи #{{ submission.id }}</h1>
                
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="{{ path('admin_form_service_custom_form_index') }}">Формы</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('admin_form_service_form_submission_card', {'id': form.id}) }}">Записи формы "{{ form.name }}"</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Детали записи</li>
                    </ol>
                </nav>
                
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Информация о записи</h3>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-3">ID записи:</dt>
                            <dd class="col-sm-9">{{ submission.id }}</dd>
                            
                            <dt class="col-sm-3">Форма:</dt>
                            <dd class="col-sm-9">{{ form.name }}</dd>
                            
                            <dt class="col-sm-3">Дата отправки:</dt>
                            <dd class="col-sm-9">{{ submission.submittedAt|date('d.m.Y H:i:s') }}</dd>
                            
                            {% if submission.userId %}
                                <dt class="col-sm-3">ID пользователя:</dt>
                                <dd class="col-sm-9">{{ submission.userId }}</dd>
                            {% endif %}
                        </dl>
                        
                        <h4 class="mt-4">Данные формы:</h4>
                        <div class="data-fields">
                            {% for field in form.structure %}
                                {% set fieldName = field.name %}
                                {% set fieldValue = submission.data[fieldName] ?? null %}
                                
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">{{ field.label }}:</label>
                                    <div class="col-sm-9">
                                        {% if field.type == 'file' %}
                                            {% if fieldValue is iterable and fieldValue|length > 0 %}
                                                <ul class="list-group">
                                                    {% for file in fieldValue %}
                                                        <li class="list-group-item">
                                                            <a href="{{ asset(file) }}" target="_blank">{{ file|split('/')|last }}</a>
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            {% else %}
                                                <span class="text-muted">Файлы не загружены</span>
                                            {% endif %}
                                        {% elseif field.type == 'checkbox' %}
                                            <span class="badge badge-{{ fieldValue ? 'success' : 'danger' }}">
                                                {{ fieldValue ? 'Да' : 'Нет' }}
                                            </span>
                                        {% elseif field.type == 'select' %}
                                            {% set selectedOption = field.options|filter(option => option.value == fieldValue)|first %}
                                            {{ selectedOption.label if selectedOption is defined else fieldValue }}
                                        {% else %}
                                            {{ fieldValue|default('') }}
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="{{ path('admin_form_service_form_submission_card', {'id': form.id}) }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Назад к списку
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}