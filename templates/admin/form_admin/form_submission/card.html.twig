{% extends 'admin/admin_index_cards.html.twig' %}

{% block title %}Записи формы "{{ form.name }}"{% endblock %}

{% block content %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <h1>Записи формы "{{ form.name }}"</h1>
                
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="{{ path('app_admin_form_service_custom_form_index') }}">Формы</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Записи формы</li>
                    </ol>
                </nav>
                
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Список записей</h3>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Дата отправки</th>
                                    <th>Краткое представление данных</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for submission in submissions %}
                                    <tr>
                                        <td>{{ submission.id }}</td>
                                        <td>{{ submission.submittedAt|date('d.m.Y H:i') }}</td>
                                        <td>
                                            {% set dataPreview = "" %}
                                            {% for key, value in submission.data %}
                                                {% if dataPreview is not empty %}{{ dataPreview ~ ', ' }}{% endif %}
                                                {% if value is iterable %}
                                                    {{ key }}: {{ value|length }} файлов
                                                {% else %}
                                                    {{ key }}: {{ value|slice(0, 50) }}{% if value|length > 50 %}...{% endif %}
                                                {% endif %}
                                            {% endfor %}
                                            {{ dataPreview|raw }}
                                        </td>
                                        <td>
                                            <a href="{{ path('admin_form_service_form_submission_card', {'id': form.id, 'card_id': submission.id}) }}" class="btn btn-info btn-sm">
                                                <i class="fas fa-eye"></i> Просмотр
                                            </a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center">Записи не найдены</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}