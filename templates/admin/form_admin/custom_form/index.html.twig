{% extends 'admin/admin_index.html.twig' %}

{% block title %}Список форм{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <h1>Управление формами</h1>
                
                <div class="mb-3">
                    <a href="{{ path('admin_form_service_custom_form_create') }}" class="btn btn-success">
                        <i class="fas fa-plus"></i> Создать форму
                    </a>
                </div>
                
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Список форм</h3>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Название</th>
                                    <th>Описание</th>
                                    <th>Активна</th>
                                    <th>Дата создания</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for form in forms %}
                                    <tr>
                                        <td>{{ form.id }}</td>
                                        <td>{{ form.name }}</td>
                                        <td>{{ form.description|default('') }}</td>
                                        <td>
                                            {% if form.isActive %}
                                                <span class="badge badge-success">Да</span>
                                            {% else %}
                                                <span class="badge badge-danger">Нет</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ form.createdAt|date('d.m.Y H:i') }}</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="{{ path('admin_form_service_custom_form_edit', {'id': form.id}) }}" class="btn btn-primary btn-sm">
                                                    <i class="fas fa-edit"></i> Редактировать
                                                </a>
                                                <a href="{{ path('admin_form_service_form_submission_card', {'id': form.id}) }}" class="btn btn-info btn-sm">
                                                    <i class="fas fa-list"></i> Записи
                                                </a>
                                                <form method="post" action="{{ path('admin_form_service_custom_form_delete', {'id': form.id}) }}" onsubmit="return confirm('Вы уверены, что хотите удалить эту форму?');" style="display: inline-block;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ form.id) }}">
                                                    <button type="submit" class="btn btn-danger btn-sm">
                                                        <i class="fas fa-trash"></i> Удалить
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="6" class="text-center">Формы не найдены</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}