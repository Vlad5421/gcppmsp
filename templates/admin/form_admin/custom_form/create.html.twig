{% extends 'admin/admin_index.html.twig' %}

{% block title %}Создание формы{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <h1>Создание формы</h1>
                
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Новая форма</h3>
                    </div>
                    {{ form_start(form, {'attr': {'id': 'form-structure-form'}}) }}
                    <div class="card-body">
                        {{ form_row(form.name) }}
                        {{ form_row(form.description) }}
                        {{ form_row(form.isActive) }}
                        
                        <div class="form-group">
                            <label>Структура формы</label>
                            <div id="form-structure-fields" data-prototype="{{ form_widget(form.structure.vars.prototype)|e('html_attr') }}">
                                {% for field in form.structure %}
                                    <div class="form-structure-field card mb-3">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <span>Поле</span>
                                            <button type="button" class="btn btn-danger btn-sm remove-field">
                                                <i class="fas fa-times"></i> Удалить
                                            </button>
                                        </div>
                                        <div class="card-body">
                                            {{ form_widget(field) }}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                            <button type="button" class="btn btn-secondary" id="add-field">
                                <i class="fas fa-plus"></i> Добавить поле
                            </button>
                        </div>
                        
                        {{ form_row(form.save) }}
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    {% block javascripts %}
        <script src="{{ asset('js/form_builder.js') }}"></script>
    {% endblock %}
{% endblock %}