{% extends 'base.html.twig' %}

{% block title %}{{ page }}{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row">
            {% if app.session.flashBag.peek('flash_message')|length > 0 %}
                <div class="row">
                    <div class="col-12">
                        <div class="alert alert-success" role="alert">
                            {% for message in app.flashes('flash_message') %}
                                <p>{{ message }}</p>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}
            
            <div class="col-lg-8 mx-auto">
                    <div id="inner-form"
                        data-url="{{ path('user_place_form_get_structure', { id: number }) }}"
                        data-geturl="{{ path('user_place_form_submit', { id: number }) }}"
                        >
                        {# data-geturl="http://localhost:8000/form.php"> #}
                    </div>

                  
                    
                    
            </div>
        </div>
    </div>
    <link rel="stylesheet" href="/widget/widget.css">

    {% block javascripts %}
        <script src="{{ asset('/widget/widget.umd.cjs') }}"></script>
    {% endblock %}
{% endblock %}